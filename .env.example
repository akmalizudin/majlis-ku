# Copy to .env and fill in. Never commit .env.
# Phase 1 needs the "App", "Database" and "Auth" sections. Later sections become required in the phase noted.

# --- App ---
# Public base URL, used in QR codes, share links and Open Graph tags
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Salt for hashing device tokens and rate-limit keys (any long random string)
HASH_SALT=change-me

# --- Database ---
# Local: npm run db:start (embedded PostgreSQL on port 5432)
DATABASE_URL=postgresql://majlis:majlis@localhost:5432/majlis?schema=public

# --- Auth (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google OAuth client (console.cloud.google.com > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email. Leave EMAIL_SERVER empty in development to print the link to the server log.
EMAIL_SERVER=
EMAIL_FROM="Majlis Ku <no-reply@example.com>"

# --- Media storage, S3-compatible (phase 2) ---
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base for thumbnails and display copies, if served through a CDN
MEDIA_CDN_URL=

# --- Payments (phase 6) ---
# Which PaymentProvider adapter to use: billplz | toyyibpay | stripe
PAYMENT_PROVIDER=
# true = gateway sandbox
PAYMENT_SANDBOX=true
PAYMENT_API_KEY=
# Secret used to verify webhook signatures
PAYMENT_WEBHOOK_SECRET=
# Gateway-specific id (Billplz collection id, ToyyibPay category code)
PAYMENT_COLLECTION_ID=

# --- Jobs (phase 8) ---
# Shared secret for the retention purge endpoint called by the scheduler
CRON_SECRET=
